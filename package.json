{
  "name": "construct",
  "private": true,
  "version": "1.0.0-alpha.1",
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "dev": "turbo run dev --filter=@construct/desktop",
    "dev:website": "pnpm --filter construct-website dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "verify": "pnpm typecheck && pnpm test && pnpm build"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "turbo": "^2.5.5",
    "typescript": "^5.8.2"
  }
}
