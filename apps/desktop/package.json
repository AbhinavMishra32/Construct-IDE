{
  "name": "@construct/desktop",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "description": "An understanding-first IDE that teaches you the project you are building.",
  "homepage": "https://construct.cc",
  "constructHostedApiOrigin": "https://api.tryconstruct.cc",
  "author": "Abhinav Mishra <AbhinavMishra32@users.noreply.github.com>",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently -k --names renderer,main,electron --prefix-colors cyan,magenta,green \"vite\" \"node scripts/dev-main.mjs\" \"wait-on tcp:5173 file:dist/.main-ready && node scripts/dev-electron.mjs\"",
    "rebuild:native": "electron-builder install-app-deps",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json",
    "test": "vitest run --passWithNoTests && ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run --config vitest.main.config.ts",
    "lint": "tsc --noEmit -p tsconfig.json",
    "build": "vite build && tsc -p tsconfig.main.json && node scripts/build-preload.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "icons": "node scripts/icon/generate-icons.mjs",
    "package": "electron-builder --mac",
    "package:win": "electron-builder --win",
    "package:linux": "electron-builder --linux"
  },
  "dependencies": {
    "@ai-sdk/provider": "2.0.3",
    "@codingame/monaco-vscode-api": "25.1.2",
    "@codingame/monaco-vscode-configuration-service-override": "^25.1.2",
    "@codingame/monaco-vscode-cpp-default-extension": "25.1.2",
    "@codingame/monaco-vscode-css-default-extension": "25.1.2",
    "@codingame/monaco-vscode-docker-default-extension": "25.1.2",
    "@codingame/monaco-vscode-files-service-override": "^25.1.2",
    "@codingame/monaco-vscode-go-default-extension": "25.1.2",
    "@codingame/monaco-vscode-html-default-extension": "25.1.2",
    "@codingame/monaco-vscode-java-default-extension": "25.1.2",
    "@codingame/monaco-vscode-javascript-default-extension": "25.1.2",
    "@codingame/monaco-vscode-json-default-extension": "25.1.2",
    "@codingame/monaco-vscode-keybindings-service-override": "^25.1.2",
    "@codingame/monaco-vscode-languages-service-override": "^25.1.2",
    "@codingame/monaco-vscode-lua-default-extension": "25.1.2",
    "@codingame/monaco-vscode-markdown-basics-default-extension": "25.1.2",
    "@codingame/monaco-vscode-model-service-override": "^25.1.2",
    "@codingame/monaco-vscode-php-default-extension": "25.1.2",
    "@codingame/monaco-vscode-python-default-extension": "25.1.2",
    "@codingame/monaco-vscode-ruby-default-extension": "25.1.2",
    "@codingame/monaco-vscode-rust-default-extension": "25.1.2",
    "@codingame/monaco-vscode-shellscript-default-extension": "25.1.2",
    "@codingame/monaco-vscode-sql-default-extension": "25.1.2",
    "@codingame/monaco-vscode-textmate-service-override": "^25.1.2",
    "@codingame/monaco-vscode-theme-defaults-default-extension": "^25.1.2",
    "@codingame/monaco-vscode-theme-service-override": "^25.1.2",
    "@codingame/monaco-vscode-typescript-basics-default-extension": "25.1.2",
    "@codingame/monaco-vscode-yaml-default-extension": "25.1.2",
    "@construct/domain": "workspace:*",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@mariozechner/pi-ai": "^0.73.1",
    "@mastra/core": "^1.49.0",
    "@phosphor-icons/react": "^2.1.7",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "basedpyright": "^1.39.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron-updater": "^6.6.2",
    "keytar": "^7.9.0",
    "lucide-react": "^1.28.0",
    "monaco-editor": "npm:@codingame/monaco-vscode-editor-api@^25.1.2",
    "monaco-languageclient": "^10.7.0",
    "motion": "^12.23.12",
    "node-pty": "^1.1.0",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-resizable-panels": "^2.1.9",
    "shadow-plugin": "^2.1.0",
    "simple-icons": "16.28.0",
    "tailwind-merge": "^3.6.0",
    "thinking-orbs": "^0.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript-language-server": "5.3.0",
    "vscode": "npm:@codingame/monaco-vscode-extension-api@^25.1.2",
    "vscode-jsonrpc": "~8.2.1",
    "vscode-languageclient": "~9.0.1",
    "web-tree-sitter": "^0.26.13",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@codingame/esbuild-import-meta-url-plugin": "^1.0.3",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "cc.construct.desktop",
    "productName": "Construct",
    "asar": true,
    "directories": {
      "output": "dist-release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "protocols": [
      {
        "name": "Construct Auth",
        "schemes": [
          "construct"
        ]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "AbhinavMishra32",
      "repo": "Construct-IDE"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/runtime-icons",
        "to": "runtime-icons"
      }
    ],
    "asarUnpack": [
      "**/node_modules/electron-liquid-glass/**",
      "**/node_modules/node-pty/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icons",
      "category": "Development",
      "executableName": "construct",
      "synopsis": "An understanding-first IDE",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  },
  "optionalDependencies": {
    "electron-liquid-glass": "^1.1.1"
  }
}
